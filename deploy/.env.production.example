# Copy to a permission-restricted secret directory; never commit the filled file.
# Values below are placeholders. No credentials are present in this template.
BIRDTIE_API_ADDR=127.0.0.1:8080
BIRDTIE_DATABASE_URL=postgres://<role>:<secret>@<private-db-host>:5432/<database>?sslmode=verify-full
# Exact, independently provisioned native target name; never civu/civu_restore.
# Also set explicitly for an owned local QA runtime; no inferred name fallback.
BIRDTIE_NATIVE_DATABASE_NAME=<database>
BIRDTIE_ALLOWED_ORIGINS=https://<approved-client-origin>
BIRDTIE_DEV_PHONE_AUTH=false
# Controlled migration/cutover stage: no automatic reminder enqueue or pixel
# purge. Approved request handlers remain enabled under their original ACLs.
BIRDTIE_BACKGROUND_MAINTENANCE=false

# Keep paid model/visual startup off until their separate activation is ready.
BIRDTIE_NOW_LIVE_CONFIG=
BIRDTIE_AGENT_VISUAL_CONFIG=
BIRDTIE_OPEN_PLACES_ENABLED=0

# OIDC values are required only after provider registration and callback review.
BIRDTIE_OIDC_ISSUER=
BIRDTIE_OIDC_CLIENT_ID=
BIRDTIE_OIDC_CLIENT_SECRET=
# Fill the entire group together after provider registration. Placeholder
# callback values alone would activate a partially configured OIDC startup.
BIRDTIE_OIDC_REDIRECT_URI=
BIRDTIE_OIDC_CLIENT_REDIRECT=

# Historical bucket placeholders do not activate the current trusted video
# storage/scanner/provider adapter. Review its own runtime contract separately.
BIRDTIE_MEDIA_BUCKET=
BIRDTIE_MEDIA_REGION_ENDPOINT=
BIRDTIE_MEDIA_UPLOAD_ENDPOINT=
BIRDTIE_MEDIA_CDN_BASE_URL=
