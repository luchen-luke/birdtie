# Copy to a permission-restricted secret directory; never commit the filled file.
# Values below are placeholders. No credentials are present in this template.
BIRDTIE_API_ADDR=127.0.0.1:8080
BIRDTIE_DATABASE_URL=postgres://<role>:<secret>@<private-db-host>:5432/<database>?sslmode=verify-full
BIRDTIE_ALLOWED_ORIGINS=https://<approved-client-origin>
BIRDTIE_DEV_PHONE_AUTH=false

# OIDC values are required only after provider registration and callback review.
BIRDTIE_OIDC_ISSUER=
BIRDTIE_OIDC_CLIENT_ID=
BIRDTIE_OIDC_CLIENT_SECRET=
BIRDTIE_OIDC_REDIRECT_URI=https://<api-host>/v1/auth/oidc/callback
BIRDTIE_OIDC_CLIENT_REDIRECT=https://<client-origin>/auth/callback

# Future provider-neutral media integration; currently unused by Birdtie.
BIRDTIE_MEDIA_BUCKET=
BIRDTIE_MEDIA_REGION_ENDPOINT=
BIRDTIE_MEDIA_UPLOAD_ENDPOINT=
BIRDTIE_MEDIA_CDN_BASE_URL=
